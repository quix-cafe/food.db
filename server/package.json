{
  "name": "@kitchen/server",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/index.js",
    "dev": "node --env-file-if-exists=../.env --watch src/index.js",
    "migrate": "node --env-file-if-exists=../.env src/migrate.js",
    "seed": "node --env-file-if-exists=../.env src/seed.js",
    "test": "node --env-file-if-exists=../.env --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "@kitchen/shared": "*",
    "express": "^5.1.0",
    "multer": "^2.4.0",
    "pg": "^8.13.0",
    "tar-stream": "^3.2.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
